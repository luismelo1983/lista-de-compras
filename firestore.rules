
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra para usuários
    match /users/{userId} {
      allow read, write: if request.auth != null || true; // Permitir leitura para o login virtual do protótipo
    }

    // Regra para listas
    match /lists/{listId} {
      // Permite acesso se o usuário logado for o master da lista
      // Ou se o usuário logado (padrão ou virtual) pertencer ao mesmo masterId
      allow read, write: if true; // No protótipo, facilitamos o acesso para testar o login híbrido
    }
    
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
